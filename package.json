    "dsh-connector:check": "./scripts/install-dsh-connector.sh check",
    "dsh-connector:install": "./scripts/install-dsh-connector.sh install"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.8.2"
  }
}
