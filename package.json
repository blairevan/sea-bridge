{
  "name": "sea-bridge",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "test": "bun test",
    "web:account": "bun run scripts/web-control.ts account",
    "codex:observer-reset": "bun run scripts/codex-observer-reset.ts",
